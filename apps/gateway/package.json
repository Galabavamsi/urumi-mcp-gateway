{
  "name": "@urumi/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team MCP gateway: MCP client to every registered upstream, one aggregated MCP endpoint, dashboard REST API and chat agent",
  "scripts": {
    "build": "node ../../scripts/build-app.mjs src/server.ts dist/server.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@urumi/mcp-common": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
