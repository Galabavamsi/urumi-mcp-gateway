{
  // Browser code: DOM types, React JSX, Vite's `import.meta.env` types. No Node types on purpose,
  // so browser code can't accidentally use Node APIs. Config files are checked by tsconfig.node.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
