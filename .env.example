# Copy to .env (gitignored) and fill in. scripts/secrets.sh turns these into Kubernetes Secrets.
# Internal secrets (DB passwords, Woo API keys, internal MCP tokens, encryption keys, JWT/pepper) are
# generated by scripts/secrets.sh straight into Kubernetes Secrets and never need to be written here.

# --- chat agent LLM (https://console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=

# --- upstream MCP credentials, held only by the gateway ---
FIRECRAWL_API_KEY=          # fc-...  (https://www.firecrawl.dev/app/api-keys)
AGENTMAIL_API_KEY=          # am_...  (https://console.agentmail.to)

# --- first admin account for the dashboard (created only when the users table is empty) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- production VPS only (scripts/vps/; see docs/VPS.md). Leave empty for the local cluster. ---
ACME_EMAIL=                 # optional Let's Encrypt account contact (Let's Encrypt sends no expiry emails since 2025)
GHCR_PULL_TOKEN=            # classic GitHub token with only read:packages, needed while the GHCR packages are private
