# secrets — never commit (scripts/secrets.sh reads .env and creates Kubernetes Secrets)
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*
*.kubeconfig
!scripts/vps/kubeconfig.sh
# the VPS's pinned SSH host key (scripts/vps/provision-aws.sh); public, but specific to one machine
.vps/

# database dumps and uploads archives (scripts/backup/fetch.sh saves outside the repo; manual dumps
# from docs/OPERATIONS.md land in the current directory). Migrations under apps/*/drizzle/ are code.
*.sql
!apps/*/drizzle/*.sql
*.sql.gz
*.dump

# private material: assignment brief, raw research notes, personal study notes, tool caches
assignment-info/
.research/
notes/
.firecrawl/
.claude/worktrees/

# node / build
node_modules/
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# helm
charts/*/charts/
*.tgz

# os / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
